{
	"spacing": 4,
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"cpu",
		"memory",
		"clock#time",
		"clock#date",
		"custom/power"
	],
	"hyprland/workspaces": {
		"format": "{name}"
	},
	"pulseaudio": {
		"format": "{volume}%"
	},
	"network": {
		"format-wifi": "{essid} ({signalStrength}%)",
		"format-ethernet": "{ipaddr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "Disconnected",
		"tooltip": false
	},
	"cpu": {
		"format": "CPU {usage}%",
		"tooltip": true
	},
	"memory": {
		"format": "RAM {}%"
	},
	"clock#time": {
		"format": "{:%H : %M}",
		"tooltip": false
	},
	"clock#date": {
		"format": "{:%Y-%m-%d}",
		"tooltip": false
	},
	"custom/power": {
		"format" : "  O  ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown now",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
	}
	/* laptop only
	"battery": {
		"bat": "BAT1",
		"interval": 60,
		"format": "{capacity}%",
		"states": {
			"warning": 30,
			"critical": 15
		}
	}
	*/
}
